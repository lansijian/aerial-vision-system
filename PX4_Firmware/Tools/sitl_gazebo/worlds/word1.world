<?xml version="1.0" ?>
<sdf version='1.6'>
  <world name='word1'>
    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>


    <!-- Lighting and scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <gravity>0 0 -9.8</gravity>

    <!-- Sun light -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose frame=''>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Roads: 2x3 grid (3 vertical + 3 horizontal) -->
    <road name='road_y_1'>
      <width>7.0</width>
      <point>-30 -50 0.02</point>
      <point>-30 50 0.02</point>
      <material>
        <script>
          <uri>file://media/materials/scripts/gazebo.material</uri>
          <name>Gazebo/Residential</name>
        </script>
      </material>
    </road>
    <road name='road_y_2'>
      <width>7.0</width>
      <point>0 -50 0.02</point>
      <point>0 50 0.02</point>
      <material>
        <script>
          <uri>file://media/materials/scripts/gazebo.material</uri>
          <name>Gazebo/Residential</name>
        </script>
      </material>
    </road>
    <road name='road_y_3'>
      <width>7.0</width>
      <point>30 -50 0.02</point>
      <point>30 50 0.02</point>
      <material>
        <script>
          <uri>file://media/materials/scripts/gazebo.material</uri>
          <name>Gazebo/Residential</name>
        </script>
      </material>
    </road>

    <road name='road_x_1'>
      <width>8.0</width>
      <point>-50 -30 0.02</point>
      <point>50 -30 0.02</point>
      <material>
        <script>
          <uri>file://media/materials/scripts/gazebo.material</uri>
          <name>Gazebo/Residential</name>
        </script>
      </material>
    </road>
    <road name='road_x_2'>
      <width>8.0</width>
      <point>-50 0 0.02</point>
      <point>50 0 0.02</point>
      <material>
        <script>
          <uri>file://media/materials/scripts/gazebo.material</uri>
          <name>Gazebo/Residential</name>
        </script>
      </material>
